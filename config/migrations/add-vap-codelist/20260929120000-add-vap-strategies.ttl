<http://lblod.data.gift/id/concept/29b23a80ab4f410399c50422e208b0a4> a skos:Concept;
    mu:uuid "29b23a80ab4f410399c50422e208b0a4";
    skos:prefLabel "Vlaanderen bouwt en verbindt groenblauwe infrastructuur, altijd en overal";
    skos:prefLabel "Vlaanderen bouwt en verbindt groenblauwe infrastructuur, altijd en overal"@nl;
    skos:notation "S1";
    skos:definition "Vlaanderenbrede groenblauwe infrastructuur: natuurgebaseerde maatregelen waar het kan, civieltechnische waar het moet. Omvat de groenblauwe metamorfose van de bebouwde kernen, klimaatrobuuste Vlaamse infrastructuur en het faciliteren van klimaatbestendig ontwerpen.";
    skos:definition "Vlaanderenbrede groenblauwe infrastructuur: natuurgebaseerde maatregelen waar het kan, civieltechnische waar het moet. Omvat de groenblauwe metamorfose van de bebouwde kernen, klimaatrobuuste Vlaamse infrastructuur en het faciliteren van klimaatbestendig ontwerpen."@nl;
